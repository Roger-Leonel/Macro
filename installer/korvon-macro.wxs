<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador MSI do Korvon Macro (WiX v4+).
  wix extension add -g WixToolset.UI.wixext/5.0.2
  wix build installer\korvon-macro.wxs -ext WixToolset.UI.wixext -arch x64 -d Version=1.0.0 -d ExePath=target\release\korvon-macro.exe -o dist\korvon-macro-1.0.0-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Korvon Macro"
           Manufacturer="Fórmula Ativa"
           Version="$(Version)"
           UpgradeCode="6B0F7C1E-3A52-4D8E-9C47-0A1B2C3D4E5F"
           Language="1046"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais nova do Korvon Macro instalada." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Korvon Macro">
        <Component Id="MainExe" Guid="*">
          <File Id="KorvonMacroExe" Source="$(ExePath)" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Korvon Macro" Advertise="yes" />
            <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Korvon Macro" Advertise="yes" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Assistente: Boas-vindas -> Pasta de instalação -> Instalar -> Concluído (sem tela de licença). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
    </UI>

    <Feature Id="Main" Title="Korvon Macro" Level="1">
      <ComponentRef Id="MainExe" />
    </Feature>
  </Package>
</Wix>
